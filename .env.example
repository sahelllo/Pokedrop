# ============================================================================
# PokeDrop – Umgebungsvariablen
#
# Diese Datei ist eine Vorlage. Zum lokalen Arbeiten kopieren:
#     cp .env.example .env.local
# .env.local ist per .gitignore ausgeschlossen und wird nie committet.
# ============================================================================

# --- Supabase (optional) ----------------------------------------------------
# Sind beide Werte gesetzt, spricht die App direkt mit deiner Datenbank.
# Fehlen sie, läuft die App unverändert auf den Demo-Daten in /data.
#
# Zu finden in Supabase unter: Project Settings → API
#
# NUR der öffentliche anon-Key gehört hier hinein. Er ist dafür gemacht, im
# Browser zu landen; geschützt wird der Zugriff durch die Row Level Security
# aus db/migrations/0002_views_rls.sql.
#
# NIEMALS hier eintragen: service_role-Key, Datenbank-Passwort, Stripe-Secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
